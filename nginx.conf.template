server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # React Router owns the URL space, so any unknown path must still return
  # index.html rather than a 404.
  location / {
    try_files $uri $uri/ /index.html;
  }

  location /api/ {
    # Substituted at container start from the BACKEND_URL environment
    # variable, so the same image works against a backend on another host.
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;

    # Server-Sent Events need these three. Without proxy_buffering off,
    # nginx holds each message until its buffer fills and the live log
    # arrives in delayed clumps instead of immediately.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 24h;
  }
}
